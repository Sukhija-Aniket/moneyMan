# Postgres connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://moneyman:moneyman@localhost:5432/moneyman

# Google OAuth (Google Cloud Console -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Fernet key for encrypting OAuth tokens at rest (Phase 1 stand-in for Cloud KMS).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# Frontend origin, used for CORS and as the post-login redirect target
FRONTEND_URL=http://localhost:5173

# Optional overrides
GMAIL_CLASSIFICATION_MODEL=claude-haiku-4-5
GMAIL_EXTRACTION_MODEL=claude-sonnet-4-5
GMAIL_SYNC_MAX_RESULTS=25
